{
    "name": "yrbane/lunar-quanta",
    "description": "Mini système PHP8",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "lunar/template": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./lunar-template"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [ "src/Service/Core/Debug/helpers.php" ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
    }
}
