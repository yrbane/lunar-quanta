{
    "name": "yrbane/lunar-quanta",
    "description": "Mini système PHP8",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "yrbane/lunar-cli": "@dev",
        "yrbane/lunar-template": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../lunar-config",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../lunar-cli",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../lunar-template",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Lunar\\": "src/"
        },
        "files": [ "src/Service/Core/Debug/helpers.php" ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4"
    }
}
