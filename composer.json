{
    "name": "yrbane/lunar-quanta",
    "description": "Mini système PHP8",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "yrbane/lunar-cli": "@dev",
        "yrbane/lunar-template": "@dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/yrbane/lunar-cli.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/yrbane/lunar-template.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lunar\\": "src/"
        },
        "files": [ "src/Service/Core/Debug/helpers.php" ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
    }
}
